# Copy this file to ".env" and edit. NEVER commit ".env" to GitHub.

# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# development (local) or production (AWS)
APP_ENV=development

# ---- Local: leave everything below empty -> SQLite is used automatically ----

# ---- AWS RDS MySQL: fill these in on the EC2 server ----
DB_HOST=
DB_PORT=3306
DB_NAME=food_ordering
DB_USER=
DB_PASSWORD=

# Or give one full URL instead of the DB_* values:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/food_ordering

# Set to true only after HTTPS is configured
SESSION_COOKIE_SECURE=false

APP_NAME=Spice Route Kitchen
